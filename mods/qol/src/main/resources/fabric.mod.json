{
  "schemaVersion": 1,
  "id": "qol_unified",
  "version": "${version}",
  "name": "Unified: QoL",
  "description": "An all-in-one, modular, client-side quality-of-life mod.",
  "authors": ["Brener Fregulia"],
  "contact": {
    "sources": "https://github.com/brener-fregulia/Unified"
  },
  "environment": "client",
  "entrypoints": {
    "client": ["unified.qol.QolUnifiedClient"],
    "unified-settings": ["unified.qol.ui.screen.QolSettingsProvider"]
  },
  "mixins": ["qol_unified.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "fabric-api": "*",
    "unified_settings": "${settings_range}"
  }
}
