{
  "schemaVersion": 1,
  "id": "unified_optimizations",
  "version": "${version}",
  "name": "Unified: Optimizations",
  "description": "Client-side performance and network optimizations. Part of Project Unified; works without the other Unified mods.",
  "authors": ["Brener Fregulia"],
  "contact": {
    "sources": "https://github.com/brener-fregulia/Unified"
  },
  "environment": "client",
  "entrypoints": {
    "client": ["unified.optimizations.UnifiedOptimizationsClient"],
    "unified-settings": ["unified.optimizations.OptimizationsSettingsProvider"]
  },
  "mixins": ["unified_optimizations.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "fabric-lifecycle-events-v1": "*",
    "unified_settings": "${settings_range}"
  }
}
