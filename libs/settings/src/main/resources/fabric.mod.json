{
  "schemaVersion": 1,
  "id": "unified_settings",
  "version": "${version}",
  "name": "Unified Settings (Library)",
  "description": "Shared settings entry point for the installed Unified mods. Nested inside each Unified mod; never installed on its own.",
  "authors": ["Brener Fregulia"],
  "contact": {
    "sources": "https://github.com/brener-fregulia/Unified"
  },
  "environment": "client",
  "entrypoints": {
    "client": ["unified.settings.UnifiedSettingsClient"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "fabric-key-mapping-api-v1": "*",
    "fabric-screen-api-v1": "*",
    "fabric-lifecycle-events-v1": "*"
  }
}
